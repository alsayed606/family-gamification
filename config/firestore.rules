rules_version = '2';

// ============================================================
//  firestore.rules — مركز الألعاب العائلي
//
//  ⚠️ هذه القواعد للمشروع المخصّص فقط. لا تنسخها إلى أي مشروع مشترك.
//
//  النموذج: مركز واحد، مدير واحد، عدة مستخدمين. لا يوجد tenantId.
//
//  ── لماذا الأدوار في مستندات لا في Custom Claims ──
//  تعيين Custom Claims يتطلب Admin SDK، أي خادمًا، أي خطة Blaze.
//  المشروع بلا ميزانية، فالأدوار تُخزَّن في users/{uid}.role وتُفحص هنا
//  عبر get(). الحماية حقيقية لأن هذه القواعد تُنفَّذ على خوادم Google
//  لا في المتصفح: المستخدم يقرأ دوره ولا يستطيع تعديله.
//
//  ── تمهيد المدير الأول ──
//  يُنشأ مستند المدير يدويًا من Firebase Console (الـ Console يتجاوز
//  القواعد). لا توجد قاعدة تسمح بالترقّي الذاتي إلى admin — بقصد.
//
//  ── ملفات الأبناء ليست حدًّا أمنيًا ──
//  users/{uid}/profiles/* بيانات عرض بحتة. لا قاعدة واحدة هنا تقرأ
//  الملفات لاتخاذ قرار تفويض، وتبديل الملف النشط يحدث في المتصفح
//  فيستحيل الوثوق به. كل الصلاحيات تبقى صلاحيات حساب ولي الأمر.
//  ولمنع أي التباس مستقبلي، يُمنع كتابة role/status داخل الملفات أصلًا.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── مساعدات ──────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // مدير = موثّق البريد + مستنده موجود + دوره admin + حسابه فعّال.
    function isAdmin() {
      return isVerified()
        && callerExists()
        && callerDoc().role == 'admin'
        && callerDoc().status == 'ACTIVE';
    }

    function isValidRole(r)   { return r == 'admin' || r == 'member'; }
    function isValidStatus(s) { return s == 'ACTIVE' || s == 'SUSPENDED'; }

    function isValidName(n) {
      return n is string && n.size() > 0 && n.size() <= 40;
    }

    // ── المستخدمون ───────────────────────────────────────────

    match /users/{userId} {

      // الخصوصية بالافتراض: لا يرى المستخدم إلا نفسه؛ المدير يرى الجميع.
      // قواعد Firestore تعمل على مستوى المستند لا الحقل، فلا يمكن إخفاء
      // البريد عن بقية الأعضاء ضمن نفس المستند — ولذلك يُمنع الوصول كليًا.
      // عند الحاجة للوحة ترتيب لاحقًا يُضاف مستند عام منفصل بحقول آمنة.
      allow read: if isSelf(userId) || isAdmin();

      // التسجيل الذاتي: بدور member حصرًا. الترقية تأتي من المدير فقط.
      // لا يُشترط توثيق البريد هنا كي يُنشأ الملف لحظة التسجيل، والدور
      // مثبَّت على member فلا خطر من ذلك.
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'ACTIVE'
        && isValidName(request.resource.data.displayName)
        && request.resource.data.email is string
        && request.resource.data.avatar is string;

      // تعديل ذاتي: الاسم والصورة فقط. الدور والحالة والمعرّف ثابتة.
      allow update: if isSelf(userId)
        && isVerified()
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.uid == resource.data.uid
        && isValidName(request.resource.data.displayName);

      // تعديل إداري: المدير يغيّر أدوار وحالات الآخرين — لا نفسه.
      // منع تعديل الذات يقي من قفل المدير لنفسه خارج النظام بالخطأ.
      allow update: if isAdmin()
        && userId != request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isValidRole(request.resource.data.role)
        && isValidStatus(request.resource.data.status)
        && isValidName(request.resource.data.displayName);

      // الحذف يفقد التاريخ ويكسر المراجع. التعطيل عبر status = SUSPENDED.
      allow delete: if false;

      // ── ملفات الأبناء ──────────────────────────────────────
      match /profiles/{profileId} {
        allow read: if (isSelf(userId) && isVerified()) || isAdmin();

        allow create, update: if isSelf(userId)
          && isVerified()
          && isValidName(request.resource.data.displayName)
          && request.resource.data.avatar is string
          && !('role' in request.resource.data)
          && !('status' in request.resource.data)
          && (
            !('ageBand' in request.resource.data)
            || request.resource.data.ageBand in
                 ['UNDER_6', '6_8', '9_12', '13_15', '16_PLUS']
          );

        allow delete: if (isSelf(userId) && isVerified()) || isAdmin();
      }
    }

    // ── بنك الأسئلة المشترك ──────────────────────────────────
    //
    //  ⚠️ الإجابة غير قابلة للإخفاء. القواعد تعمل على مستوى المستند لا
    //  الحقل، فمن يقرأ السؤال يقرأ answer معه. البنك صالح لوضع free play
    //  ولا يقاوم الغش. إخفاؤها يتطلب Cloud Function، أي خطة Blaze.
    //
    //  ── نموذج المراجعة ──
    //  العضو يقترح (DRAFT باسمه)، والمدير وحده ينشر. فيبقى ما يراه
    //  الجميع مسؤولية المدير، مع بقاء المساهمة مفتوحة.
    //
    //  ── القواعد ليست مرشِّحات ──
    //  في استعلامات list يجب أن تثبت قيود الاستعلام نفسها أن كل نتيجة
    //  مسموحة. فاستعلام العضو لازمه where('status','==','PUBLISHED')
    //  أو where('createdBy','==',uid) وإلا رُفض كاملًا — لا مقصوصًا.

    match /questions/{questionId} {

      function isActiveMember() {
        return isVerified()
          && callerExists()
          && callerDoc().status == 'ACTIVE';
      }

      function isValidType(t) {
        return t == 'MCQ' || t == 'TRUE_FALSE' || t == 'WORD_SCRAMBLE';
      }

      function isValidDifficulty(d) {
        return d == 'EASY' || d == 'MEDIUM' || d == 'HARD';
      }

      function isText(s, maxLen) {
        return s is string && s.size() > 0 && s.size() <= maxLen;
      }

      // شكل الخيارات والإجابة بحسب النوع. الثابت الجوهري في نوعَي
      // الاختيار: الإجابة أحد الخيارات — فيستحيل سؤال بلا إجابة صحيحة.
      // كلمة من حرفين لا تُبعثر بصورة ذات معنى، فالحدّ الأدنى ثلاثة.
      function isValidShape(d) {
        return (
          d.type == 'WORD_SCRAMBLE'
            ? !('choices' in d) && d.answer.size() >= 3
            : d.choices is list
              && d.choices.size() >= 2
              && d.choices.size() <= 6
              && d.answer in d.choices
              && (d.type != 'TRUE_FALSE' || d.choices == ['صح', 'خطأ'])
        );
      }

      function isValidQuestion(d) {
        return isValidType(d.type)
          && isText(d.prompt, 300)
          && isText(d.answer, 120)
          && isText(d.category, 40)
          && isValidDifficulty(d.difficulty)
          && isValidShape(d);
      }

      // المنشور لكل عضو فعّال؛ والمسوّدة لصاحبها؛ والمدير يرى الكل.
      allow read: if isActiveMember() && (
        resource.data.status == 'PUBLISHED'
        || resource.data.createdBy == request.auth.uid
        || isAdmin()
      );

      // العضو يقترح مسوّدة باسمه فقط. المدير ينشئ منشورًا مباشرة.
      // تثبيت createdBy على المنادي يمنع نسبة الاقتراح لغيره.
      allow create: if isActiveMember()
        && request.resource.data.createdBy == request.auth.uid
        && isValidQuestion(request.resource.data)
        && (
          request.resource.data.status == 'DRAFT'
          || (request.resource.data.status == 'PUBLISHED' && isAdmin())
        );

      // صاحب المسوّدة يعدّلها ما دامت مسوّدة. لا يملك نشرها،
      // ولا يمسّ منشورًا — حتى لو كان هو من اقترحه.
      allow update: if isActiveMember()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'DRAFT'
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.createdBy == resource.data.createdBy
        && isValidQuestion(request.resource.data);

      // المدير يراجع وينشر ويسحب — ولا ينسب السؤال لغير مُنشئه.
      allow update: if isAdmin()
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.resource.data.status == 'DRAFT'
            || request.resource.data.status == 'PUBLISHED')
        && isValidQuestion(request.resource.data);

      // الحذف للمدير، ولصاحب المسوّدة قبل نشرها.
      allow delete: if isAdmin()
        || (isActiveMember()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'DRAFT');
    }

    // ── كل ما عدا ذلك ────────────────────────────────────────
    // أي مجموعة بلا قاعدة allow صريحة مرفوضة تلقائيًا. هذا البلوك
    // توثيق صريح للنيّة، ولا يمنح شيئًا.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

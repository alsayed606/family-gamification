rules_version = '2';

// ============================================================
//  firestore.rules — مشروع مركز الألعاب العائلي (المخصّص)
//
//  ⚠️ هذه القواعد للمشروع الجديد المخصّص فقط.
//  لا تنسخها إلى مشروع marine-command-center — راجع docs/PHASE-0.md
//  للتعليمات الخاصة بتنظيف المشروع المشترك.
//
//  المرحلة 0 — الوضع الحالي: رفض كل شيء.
//  التطبيق لا يملك حتى الآن نظام مصادقة حقيقيًا، والقاعدة الذهبية أن
//  ما لا يمكن التحقق منه لا يُسمح به. البيانات القديمة (fam_*) اعتُبرت
//  بيانات تجريبية ولن تُرحَّل (قرار "بداية نظيفة").
//
//  المرحلة 1 — ما سيُبنى فوق هذا الأساس:
//    - Firebase Auth: ولي أمر موثّق البريد + أدوار عبر Custom Claims.
//    - عضوية العائلة تُفحص بـ exists() على مستند العضو، لا عبر
//      claim باسم familyId (الـ claims تتأخر حتى ساعة عند التحديث،
//      وتنكسر مع تعدّد العائلات أو إنشاء عائلة جديدة).
//    - كل كتابة على النقاط/الدفتر/قرارات المراجعة تتم من الخادم حصرًا،
//      ويبقى allow write: if false للعميل دائمًا.
//    - الإجابة الصحيحة لا تُخزَّن في نفس مستند السؤال، لأن قواعد
//      Firestore تعمل على مستوى المستند لا الحقل.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // رفض شامل حتى تُبنى المصادقة والأدوار في المرحلة 1.
    // أي مجموعة لا تملك قاعدة allow صريحة تُرفض تلقائيًا — وهذا مقصود.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

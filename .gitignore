# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Node (if ever added)
node_modules/
npm-debug.log*

# Environment / secrets (never push these)
.env
.env.local
*.secret

# إعدادات Firebase المحلية (كل مطوّر يضبط مشروعه)
src/js/firebase-config.local.js
.firebaserc

# Build output — ignored by default, EXCEPT games/*/dist which is committed
# on purpose: GitHub Pages serves this repo as-is with no CI build step, so
# each game's built output must be checked in (run `npm run awc:build` etc.
# before pushing). See README.md "الألعاب" section.
dist/
build/
!games/*/dist/
!games/*/dist/**

# TypeScript incremental build cache (tsc -b)
*.tsbuildinfo
